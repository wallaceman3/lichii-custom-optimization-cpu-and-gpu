 src/video_core/vulkan_common/vulkan_device.h  | 13 +++-
 .../vulkan_common/vulkan_memory_allocator.cpp | 74 ++++++++++++++++++-
 .../vulkan_common/vulkan_memory_allocator.h   |  7 ++
 4 files changed, 91 insertions(+), 7 deletions(-)

